{
  "name": "aragon-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Photo upload API: auth with email OTP, signed S3 uploads and async image validation",
  "type": "module",
  "engines": {
    "node": ">=24.7"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "db:migrate": "tsx src/db/migrate.ts up",
    "db:migrate:down": "tsx src/db/migrate.ts down",
    "db:migrate:prod": "node dist/db/migrate.js up",
    "setup:bucket": "tsx scripts/setup-bucket.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-presigned-post": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "bullmq": "^6.5.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "file-type": "^22.3.0",
    "heic-decode": "^2.1.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.14",
    "nodemailer": "^10.3.1",
    "onnxruntime-node": "^1.31.1",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "rate-limit-redis": "^6.0.2",
    "sequelize": "^6.37.8",
    "sharp": "^0.35.5",
    "umzug": "^3.8.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
