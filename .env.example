NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Number of reverse proxies in front of the API (nginx = 1). Used for client IPs in rate limits.
TRUST_PROXY=0
# Comma-separated browser origins allowed to call the API (CORS + cookie routes).
APP_ORIGINS=http://localhost:5173

# Postgres (Neon). Use the pooled URL for the app.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=verify-full
DATABASE_SSL=true
DATABASE_POOL_MAX=10

REDIS_URL=redis://127.0.0.1:6379

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
OTP_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# lax when the frontend reaches the API on the same site (dev proxy / Amplify rewrite); none for cross-site.
REFRESH_COOKIE_SAMESITE=lax

# S3. Locally the AWS SDK reads AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY; on EC2 it uses the instance role.
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_KEY_PREFIX=dev/

# Gmail SMTP (app password). Leave SMTP_USER empty in development to print OTPs to the log instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

WORKER_CONCURRENCY=2
